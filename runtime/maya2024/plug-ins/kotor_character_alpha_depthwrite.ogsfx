// KotOR non-envmapped character material with source object opacity.
// The C++ MPxShaderOverride supplies normal alpha blending with depth writes
// enabled so the nearest surface occludes rear hair and limbs during a fade.

uniform texture2D map
<
    string UIName = "KotOR Diffuse Texture";
    string UIWidget = "FilePicker";
    string ResourceType = "2D";
    string ResourceName = "";
>;

uniform sampler2D mapSampler = sampler_state
{
    Texture = <map>;
    TEXTURE_MIN_FILTER = LINEAR_MIPMAP_LINEAR;
    TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = REPEAT;
    TEXTURE_WRAP_T = REPEAT;
};

uniform vec3 sourceDiffuse = {1.0, 1.0, 1.0};
uniform vec3 sourceAmbient = {1.0, 1.0, 1.0};
uniform vec3 sourceSelfIllum = {0.0, 0.0, 0.0};
uniform float inspectionAmbientIntensity = 0.2;
uniform float inspectionDiffuseIntensity = 0.8;
uniform float objectOpacity = 1.0;
uniform mat4 WorldViewProjection : worldviewprojection;

attribute vertexInS
{
    vec3 Pm : POSITION;
    vec2 mayaUVIn : TEXCOORD0;
}

attribute vertOutS
{
    vec2 U0 : TEXCOORD0;
}

GLSLShader characterVertex
{
    void main()
    {
        VS_OUT.U0 = vec2(mayaUVIn.x, 1.0 - mayaUVIn.y);
        gl_Position = WorldViewProjection * vec4(Pm, 1.0);
    }
}

attribute fragInS
{
    vec2 U0 : TEXCOORD0;
}

attribute fragOutS
{
    vec4 ColorOut;
}

GLSLShader characterPixel
{
    float srgbChannelToLinear(float value)
    {
        return value <= 0.04045
            ? value / 12.92
            : pow((value + 0.055) / 1.055, 2.4);
    }

    vec3 srgbToLinear(vec3 value)
    {
        return vec3(
            srgbChannelToLinear(value.r),
            srgbChannelToLinear(value.g),
            srgbChannelToLinear(value.b)
        );
    }

    void main()
    {
        vec4 sampled = texture(mapSampler, PIX_IN.U0);
        vec3 legacyLighting = clamp(
            sourceAmbient * inspectionAmbientIntensity +
            sourceDiffuse * inspectionDiffuseIntensity,
            0.0,
            1.0
        );
        vec3 legacyDisplayColor =
            sampled.rgb * legacyLighting +
            sampled.rgb * sourceSelfIllum;
        ColorOut = vec4(srgbToLinear(legacyDisplayColor), objectOpacity);
    }
}

technique Main
{
    pass P0
    {
        VertexShader (in vertexInS, out vertOutS VS_OUT) = characterVertex;
        PixelShader (in fragInS PIX_IN, out fragOutS) = characterPixel;
    }
}
