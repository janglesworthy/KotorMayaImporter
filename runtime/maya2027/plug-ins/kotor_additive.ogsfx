// KotOR additive material for Maya Viewport 2.0.
//
// This deliberately mirrors the retail fixed-function material draw:
//   vertex position -> WorldViewProjection
//   source diffuse UV -> texture sample
//   RGB *= authored self-illumination/diffuse gain
//   A   *= authored mesh alpha
//
// Blend, depth, and raster state are installed by the MPxShaderOverride.
// There is no alpha discard, depth-priority offset, lighting, or Maya
// transparency helper in this effect.

uniform texture2D map
<
    string UIName = "KotOR Diffuse Texture";
    string UIWidget = "FilePicker";
    string ResourceType = "2D";
    string ResourceName = "";
>;

uniform sampler2D mapSampler = sampler_state
{
    Texture = <map>;
    TEXTURE_MIN_FILTER = LINEAR_MIPMAP_LINEAR;
    TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = REPEAT;
    TEXTURE_WRAP_T = REPEAT;
};

uniform vec3 colorGain = {1.0, 1.0, 1.0};
uniform float alphaGain = 1.0;
uniform mat4 WorldViewProjection : worldviewprojection;

attribute vertexInS
{
    vec3 Pm : POSITION;
    vec2 mayaUVIn : TEXCOORD0;
}

attribute vertOutS
{
    vec2 U0 : TEXCOORD0;
}

GLSLShader reqdVtxFormat_VS
{
    void main()
    {
        // MTextureManager-backed custom effects use the graphics texture origin,
        // while Maya supplies TEXCOORD0 in Maya's image-space convention.  Keep
        // source UVs canonical and normalize only at the custom shader boundary.
        VS_OUT.U0 = vec2(mayaUVIn.x, 1.0 - mayaUVIn.y);
        gl_Position = WorldViewProjection * vec4(Pm, 1.0);
    }
}

attribute fragInS
{
    vec2 U0 : TEXCOORD0;
}

attribute fragOutS
{
    vec4 ColorOut;
}

GLSLShader reqdVtxFormat
{
    void main()
    {
        vec4 sampled = texture(mapSampler, PIX_IN.U0);
        ColorOut = vec4(
            sampled.rgb * colorGain,
            sampled.a * alphaGain
        );
    }
}

technique Main
<
    string Transparency = "Transparent";
>
{
    pass P0
    {
        VertexShader (in vertexInS, out vertOutS VS_OUT) = reqdVtxFormat_VS;
        PixelShader (in fragInS PIX_IN, out fragOutS) = reqdVtxFormat;
    }
}
