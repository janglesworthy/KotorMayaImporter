// KotOR ordinary opaque character material for Maya Viewport 2.0.
//
// The retail renderer uploads ordinary RGB/RGBA textures without an sRGB
// internal format, applies fixed-function lighting, and modulates the texture
// in that legacy display/gamma space.  Maya's color-managed viewport expects a
// scene-linear shader result, so this effect converts the completed legacy
// display color to scene linear only at the host-output boundary.
//
// The empty-asset inspection scene has no authored KotOR area lights.  Its
// camera-facing neutral light is therefore explicitly a presentation input,
// not a recovered level-light claim.

uniform texture2D map
<
    string UIName = "KotOR Diffuse Texture";
    string UIWidget = "FilePicker";
    string ResourceType = "2D";
    string ResourceName = "";
>;

uniform sampler2D mapSampler = sampler_state
{
    Texture = <map>;
    TEXTURE_MIN_FILTER = LINEAR_MIPMAP_LINEAR;
    TEXTURE_MAG_FILTER = LINEAR;
    TEXTURE_WRAP_S = REPEAT;
    TEXTURE_WRAP_T = REPEAT;
};

uniform vec3 sourceDiffuse = {1.0, 1.0, 1.0};
uniform vec3 sourceAmbient = {1.0, 1.0, 1.0};
uniform float inspectionAmbientIntensity = 0.2;
uniform float inspectionDiffuseIntensity = 0.8;
uniform mat4 WorldViewProjection : worldviewprojection;
uniform mat4 WorldView : worldview;

attribute vertexInS
{
    vec3 Pm : POSITION;
    vec3 Nm : NORMAL;
    vec2 mayaUVIn : TEXCOORD0;
}

attribute vertOutS
{
    vec2 U0 : TEXCOORD0;
    vec3 Nv : TEXCOORD1;
}

GLSLShader characterVertex
{
    void main()
    {
        VS_OUT.U0 = vec2(mayaUVIn.x, 1.0 - mayaUVIn.y);
        VS_OUT.Nv = normalize((WorldView * vec4(Nm, 0.0)).xyz);
        gl_Position = WorldViewProjection * vec4(Pm, 1.0);
    }
}

attribute fragInS
{
    vec2 U0 : TEXCOORD0;
    vec3 Nv : TEXCOORD1;
}

attribute fragOutS
{
    vec4 ColorOut;
}

GLSLShader characterPixel
{
    float srgbChannelToLinear(float value)
    {
        return value <= 0.04045
            ? value / 12.92
            : pow((value + 0.055) / 1.055, 2.4);
    }

    vec3 srgbToLinear(vec3 value)
    {
        return vec3(
            srgbChannelToLinear(value.r),
            srgbChannelToLinear(value.g),
            srgbChannelToLinear(value.b)
        );
    }

    void main()
    {
        vec4 sampled = texture(mapSampler, PIX_IN.U0);
        float facing = max(normalize(PIX_IN.Nv).z, 0.0);
        vec3 legacyLighting = clamp(
            sourceAmbient * inspectionAmbientIntensity +
            sourceDiffuse * inspectionDiffuseIntensity * facing,
            0.0,
            1.0
        );
        vec3 legacyDisplayColor = sampled.rgb * legacyLighting;
        ColorOut = vec4(srgbToLinear(legacyDisplayColor), 1.0);
    }
}

technique Main
{
    pass P0
    {
        VertexShader (in vertexInS, out vertOutS VS_OUT) = characterVertex;
        PixelShader (in fragInS PIX_IN, out fragOutS) = characterPixel;
    }
}
